<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>CFBundleDisplayName</key>
	<string>Routinist</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>WKApplication</key>
	<true/>
	<key>WKBackgroundModes</key>
	<array>
		<!-- 필수: 없으면 화면 꺼짐/앱 이탈 시 워크아웃 세션이 백그라운드 유지 안 됨
		     (322 fix — 음성 첫 발화 후 중단 + 복귀 시 완료 처리 버그의 공통 원인) -->
		<string>workout-processing</string>
		<!-- v15 crash fix (hans 실기기): 이 모드 없이 allowsBackgroundLocationUpdates=true
		     설정 시 NSInvalidArgumentException — 카운트다운 직후 앱이 통째로 사라지던 원인 -->
		<string>location</string>
	</array>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.routinist.app</string>
	<key>NSHealthShareUsageDescription</key>
	<string>달리기 중 심박수·거리를 실시간으로 보여주기 위해 건강 데이터를 읽어요.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>완주한 러닝을 Apple Health 운동으로 저장해 iPhone 의 Routinist 와 자동으로 동기화해요.</string>
	<key>NSMotionUsageDescription</key>
	<string>자동 일시정지 후 다시 움직이면 러닝을 자동으로 이어서 재기 위해 걸음을 감지해요.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>러닝 경로를 지도에 그리기 위해 달리는 동안 위치를 기록해요.</string>
</dict>
</plist>
