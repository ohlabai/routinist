# Routinist iOS 자동화 — fastlane
# 사용법:
#   cd ios && fastlane beta        # TestFlight 업로드
#   cd ios && fastlane release     # App Store 제출 (메타데이터 + 빌드)
#
# App Store Connect API key 정보는 .env.fastlane 에 두고 dotenv 로 로드.

default_platform(:ios)

# ─── App Store Connect API key 로드 ───────────────────────────────────
# .env.fastlane 에서 ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH 읽음.
# 2FA 우회 가능 (Apple ID 비밀번호 + 인증코드 매번 안 입력).
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    duration: 1200,
    in_house: false,
  )
end

platform :ios do
  before_all do
    # 매번 fastlane 시작 시 .env.fastlane 자동 로드 (gitignore)
    Dotenv.load("../.env.fastlane") if File.exist?("../.env.fastlane")
  end

  # ─── lane: build ────────────────────────────────────────────────────
  desc "웹 번들 빌드 + cap sync iOS + xcodebuild archive"
  lane :build do
    # 1. Next.js 정적 export + capacitor 동기화
    sh("cd .. && npm run build:ios")

    # 2. Xcode archive — 자동 sign 에 맡김. project.pbxproj 의 CODE_SIGN_IDENTITY 가
    # "Apple Development" 로 설정되면 Xcode 가 archive 시 자동으로 Distribution 인증서로 매칭.
    # codesigning_identity 강제 지정은 SPM 의존 패키지들과 충돌 (build 59 회고).
    build_app(
      project: "App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Routinist.ipa",
      clean: true,
      export_options: {
        signingStyle: "automatic",
        teamID: "EHQP3GVR66",
      },
    )
  end

  # ─── lane: beta (TestFlight 만) ─────────────────────────────────────
  desc "build + TestFlight 업로드 (외부 테스터 없이)"
  lane :beta do
    build
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: "./build/Routinist.ipa",
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("CHANGELOG", "버그 수정 + UX 개선"),
    )
  end

  # ─── lane: release (App Store 제출) ─────────────────────────────────
  desc "build + 메타데이터 + 스크린샷 + Submit for Review"
  lane :release do
    build
    upload_to_app_store(
      api_key: asc_api_key,
      ipa: "./build/Routinist.ipa",
      submit_for_review: false,        # 처음엔 false 로 검토 후 수동 제출 권장
      automatic_release: false,
      force: true,                     # html preview 안 띄움
      skip_screenshots: true,          # 스크린샷은 별도 lane 으로 나중에
      skip_metadata: false,
      precheck_include_in_app_purchases: false,
    )
  end

  # ─── lane: meta (메타데이터만 갱신) ─────────────────────────────────
  # 사용: cd ios && fastlane meta                       # 현재 editable 버전 사용
  #      cd ios && fastlane meta VERSION:=1.2.3         # 명시 버전 (없으면 자동 생성)
  desc "메타데이터/설명/키워드만 갱신 (빌드 X). VERSION 인자 옵션."
  lane :meta do |options|
    raw_version = (options[:VERSION] || ENV["META_VERSION"]).to_s
    app_version = raw_version[/\d+\.\d+\.\d+|\d+\.\d+/]
    args = {
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,  # API key 로 IAP precheck 불가 (IAP 없음)
      run_precheck_before_submit: false,
    }
    if app_version
      args[:app_version] = app_version
      UI.message("meta: targeting app_version=#{app_version}")
    end
    upload_to_app_store(args)
  end

  # ─── lane: hotfix (이미 archive·업로드된 빌드를 v1.2.1 로 ASC 에 등록 + submit) ──
  # 사용: cd ios && fastlane hotfix VERSION:=1.2.1 BUILD:=241
  desc "ASC 새 버전 생성 + 빌드 attach + release_notes + Submit for Review"
  lane :hotfix do |options|
    # 인자 파싱 — fastlane CLI 의 콜론 syntax 가 prefix 문자열 오염시키는 회귀가 있어
    # 정규표현식으로 숫자.숫자.숫자 추출 (e.g. "=1.2.1" 또는 "1.2.1" 모두 정상 처리).
    raw_version = (options[:VERSION] || ENV["HOTFIX_VERSION"] || "1.2.1").to_s
    raw_build = (options[:BUILD] || ENV["HOTFIX_BUILD"] || "241").to_s
    app_version = raw_version[/\d+\.\d+\.\d+|\d+\.\d+/] || "1.2.1"
    build_num = raw_build[/\d+/] || "241"
    UI.message("Hotfix submit: version=#{app_version} build=#{build_num} (raw_version=#{raw_version.inspect})")
    upload_to_app_store(
      api_key: asc_api_key,
      app_version: app_version,
      build_number: build_num,
      skip_binary_upload: true,        # 빌드는 이미 Xcode 에서 업로드 완료
      skip_screenshots: true,           # 스크린샷 변경 없음
      skip_metadata: false,             # release_notes 갱신
      submit_for_review: true,          # 자동으로 Submit
      automatic_release: true,          # 승인 즉시 자동 출시
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      # 자동 답변 (이전 버전과 동일)
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )
    UI.success("✅ v#{app_version} (#{build_num}) submitted. Expedited Review 는 ASC 웹에서 직접 클릭해야 함.")
  end

  # ─── lane: list_builds (최근 ASC 업로드 빌드 + processing state) ──
  desc "ASC 최근 빌드 + processing state 진단"
  lane :list_builds do
    require 'spaceship'
    asc_api_key
    app = Spaceship::ConnectAPI::App.find("com.routinist.app")
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      sort: "-uploadedDate",
      limit: 10,
    )
    builds.each do |b|
      UI.message("build=#{b.version}  state=#{b.processing_state}  uploaded=#{b.uploaded_date}")
    end
  end

  # ─── lane: build_train (빌드가 어느 버전 트레인에 속했는지 진단) ──
  desc "최근 빌드의 train (CFBundleShortVersionString) 표시"
  lane :build_train do
    require 'spaceship'
    asc_api_key
    app = Spaceship::ConnectAPI::App.find("com.routinist.app")
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, sort: "-uploadedDate", limit: 5, includes: "preReleaseVersion",
    )
    builds.each do |b|
      train = b.pre_release_version ? b.pre_release_version.version : "?"
      UI.message("build=#{b.version}  train=#{train}  state=#{b.processing_state}")
    end
  end

  # ─── lane: list_versions (ASC 의 모든 app_store_version 디버그용) ──
  desc "ASC 의 모든 버전 나열 (망가진 버전 진단)"
  lane :list_versions do
    require 'spaceship'
    asc_api_key  # 토큰 set up
    app = Spaceship::ConnectAPI::App.find("com.routinist.app")
    UI.message("App: #{app.name} (#{app.bundle_id})")
    versions = app.get_app_store_versions(filter: { platform: "IOS" })
    versions.each do |v|
      UI.message("id=#{v.id}  version=#{v.version_string.inspect}  state=#{v.app_store_state}")
    end
  end

  # ─── lane: rename_bad_version (망가진 버전 이름만 수정) ──────────────
  desc "ASC 의 versionString 수정 (=1.2.1 → 1.2.1)"
  lane :rename_bad_version do |options|
    require 'spaceship'
    asc_api_key
    target_id = options[:ID] || ENV["TARGET_ID"]
    new_version = options[:TO] || ENV["NEW_VERSION"]
    UI.user_error!("ID + TO 필요") unless target_id && new_version
    app = Spaceship::ConnectAPI::App.find("com.routinist.app")
    versions = app.get_app_store_versions(filter: { platform: "IOS" })
    target = versions.find { |v| v.id == target_id.to_s }
    UI.user_error!("버전 ID #{target_id} 없음") unless target
    UI.message("rename: #{target.id} '#{target.version_string}' → '#{new_version}'")
    target.update(attributes: { versionString: new_version })
    UI.success("✅ rename 완료")
  end

  # ─── lane: screenshots (스크린샷 업로드만) ───────────────────────────
  desc "fastlane/screenshots/ 의 이미지를 App Store Connect 에 업로드"
  lane :screenshots do
    upload_to_app_store(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      overwrite_screenshots: true,
    )
  end
end

  # ─── lane: reject_pending (심사 대기/진행 중 버전 회수 — 긴급용) ──
  desc "현재 WAITING_FOR_REVIEW / IN_REVIEW 버전을 developer reject"
  lane :reject_pending do
    require 'spaceship'
    asc_api_key
    app = Spaceship::ConnectAPI::App.find("com.routinist.app")
    version = app.get_edit_app_store_version
    if version.nil?
      UI.important("editable 버전 없음 — 회수할 대상 없음")
    else
      UI.message("target: v#{version.version_string} state=#{version.app_store_state}")
      submission = begin
        Spaceship::ConnectAPI.get_review_submissions(app_id: app.id, filter: { state: "WAITING_FOR_REVIEW,IN_REVIEW,UNRESOLVED_ISSUES,READY_FOR_REVIEW" }).first
      rescue
        nil
      end
      if submission
        submission.cancel_submission
        UI.success("✅ review submission 취소 완료 (v#{version.version_string})")
      else
        UI.important("취소할 submission 못 찾음 — ASC 웹에서 수동 확인 필요")
      end
    end
  end
