<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- routinist:// 딥링크 전체 커버리지 (iOS 와 동일).
                 auth/callback 외에도 invite, r/[id], payment, world 등 모든 path 를
                 앱이 받아야 하므로 host 제한 없이 scheme 단위로 매칭. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>

        </activity>

        <!-- Health Connect 권한 rationale UI 는 @capgo/capacitor-health 가 자체 제공
             (PermissionsRationaleActivity + ViewPermissionUsageActivity alias 가
             플러그인 manifest 에서 merge 됨). 앱 쪽에 중복 선언하면 Android 14+
             VIEW_PERMISSION_USAGE 처리가 모호해지므로 여기선 선언하지 않고,
             표시할 개인정보처리방침 URL 만 strings.xml 의
             health_connect_privacy_policy_url 로 지정한다. -->

        <!-- 러닝 세션 FGS — RunSessionEngine 유지 장치 (좌표 적산·자동정지·음성·알림) -->
        <service
            android:name=".RunSessionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 갤럭시 워치(:wear) 완주 러닝 수신 — Wearable Data Layer.
             워치가 DataClient 로 /routinist/run/* 를 보내면 로컬 pending 큐에 쌓고,
             앱 포그라운드 시 WatchRunInbox 플러그인이 JS 로 넘겨 기존 저장 플로우로 Supabase 저장. -->
        <service
            android:name=".WatchRunReceiverService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/routinist/run" />
            </intent-filter>
            <!-- 워치 음성 릴레이 (2026-08-02): 백그라운드에서도 /routinist/voice 메시지로 깨어나게
                 + 라이브 미러 (2026-08-03): /routinist/live 지표 → 잠금화면 알림·/track 패널 -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/routinist/voice" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/routinist/live" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- GPS 트래킹 (러닝 기록) -->
    <!-- while-in-use 위치 + FGS(location) 조합 (Android Phase 2, RunSessionService).
         러닝 중 화면 잠금/앱 전환에도 네이티브 엔진이 좌표 적산을 계속한다.
         ACCESS_BACKGROUND_LOCATION 은 불필요 — FGS 를 포그라운드 사용자 액션으로
         시작하는 패턴이라 while-in-use 로 충분 (러닝 앱 표준). Play Console 에
         FOREGROUND_SERVICE_LOCATION 사용 선언 필요 (제출 시 사용자 액션). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 트래킹 중 doze 진입 시 엔진 tick 정지 차단 (RunSessionService partial wake lock) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- FCM 푸시 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 카메라 (활동 사진 촬영) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Health Connect 권한 (러닝 기록 동기화 — iOS HealthKit 매핑)
         2026-07-18 Play 거절 (헬스 커넥트 최소 범위) 대응: 실사용 3종만 유지.
         - READ_EXERCISE: 러닝 세션 조회 (queryWorkouts)
         - READ_DISTANCE: 세션 거리 집계 (DistanceRecord.DISTANCE_TOTAL)
         - READ_ACTIVE_CALORIES_BURNED: 세션 칼로리 집계 (ACTIVE_CALORIES_TOTAL)
         - READ_EXERCISE_ROUTE: 러닝 경로 좌표 → 기록 지도/공유카드 표시
           (2026-07-18 Android 경로 동기화 활성화 — iOS 와 동일 파이프라인)
         제거: STEPS·TOTAL_CALORIES(어떤 코드 경로도 안 읽음)·HEART_RATE(권한만 있고
         저장 코드 없음). -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />

    <!-- @capgo/capacitor-health 가 병합하는 미사용 권한 제거 — Health Connect 심사는
         선언된 모든 권한의 사용 근거를 요구하므로 위 읽기 3종 외 전부 차단 -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" tools:node="remove" />

    <!-- Health Connect를 지원하는지 검사 -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
