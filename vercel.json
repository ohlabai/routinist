{
  "rewrites": [
    { "source": "/((?!_next|api|privacy|support|\\.well-known|r/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/push/send", "schedule": "* * * * *" },
    { "path": "/api/cafe24/import", "schedule": "0 19 * * *" },
    { "path": "/api/cron/cleanup-stale-orders", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/engagement", "schedule": "0 11 * * *" },
    { "path": "/api/cron/world-chase", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/assign-rivals", "schedule": "30 15 1 * *" },
    { "path": "/api/cron/rival-callouts", "schedule": "0 9 * * *" }
  ]
}
